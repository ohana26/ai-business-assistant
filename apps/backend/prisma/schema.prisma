generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum SecurityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum KnowledgeBaseStatus {
  ACTIVE
  ARCHIVED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeSourceType {
  FILE_UPLOAD
  GOOGLE_DRIVE
  ONEDRIVE
  EMAIL
  SLACK
  DATABASE
  API
  WEB
  MANUAL
}

enum KnowledgeSourceStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum KnowledgeAssetStatus {
  UPLOADED
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AssetContentType {
  PDF
  DOCX
  TXT
  MARKDOWN
  HTML
  CSV
  JSON
  EMAIL_MESSAGE
  SLACK_MESSAGE
  DB_ROW
  API_RECORD
  OTHER
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique
  passwordHash        String
  displayName         String?
  status              UserStatus   @default(ACTIVE)
  lastLoginAt         DateTime?
  memberships         Membership[]
  invitedMemberships  Membership[] @relation("MembershipInviter")
  refreshTokens       RefreshToken[]
  profile             UserProfile?
  attributes          UserAttribute[]
  auditLogs           AuditLog[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  @@index([status])
  @@index([deletedAt])
}

model UserProfile {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @unique @db.Uuid
  department    String?
  jobTitle      String?
  location      String?
  securityLevel SecurityLevel @default(INTERNAL)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([location])
  @@index([securityLevel])
  @@index([deletedAt])
}

model UserAttribute {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, key])
  @@index([key, value])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([createdAt])
}

model Company {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  status      String       @default("ACTIVE")
  memberships Membership[]
  roles       Role[]
  workspaces  Workspace[]
  auditLogs   AuditLog[]
  knowledgeBases      KnowledgeBase[]
  collections         Collection[]
  knowledgeSources    KnowledgeSource[]
  knowledgeAssets     KnowledgeAsset[]
  documentMetadatas   DocumentMetadata[]
  chunks              Chunk[]
  embeddings          Embedding[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([deletedAt])
}

model Membership {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  companyId            String                @db.Uuid
  roleId               String                @db.Uuid
  status               MembershipStatus      @default(PENDING)
  invitedByUserId      String?               @db.Uuid
  joinedAt             DateTime?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role                 Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedByUser        User?                 @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  workspaceMemberships WorkspaceMembership[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([userId, status])
  @@index([roleId])
  @@index([deletedAt])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String?          @db.Uuid
  name            String
  description     String?
  isSystemRole    Boolean          @default(false)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@unique([companyId, name])
  @@index([companyId, isSystemRole])
  @@index([deletedAt])
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Workspace {
  id                   String                @id @default(uuid()) @db.Uuid
  companyId            String                @db.Uuid
  name                 String
  slug                 String
  description          String?
  status               WorkspaceStatus       @default(ACTIVE)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workspaceMemberships WorkspaceMembership[]
  knowledgeBases       KnowledgeBase[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([deletedAt])
}

model WorkspaceMembership {
  id            String        @id @default(uuid()) @db.Uuid
  membershipId  String        @db.Uuid
  workspaceId   String        @db.Uuid
  workspaceRole WorkspaceRole @default(MEMBER)
  membership    Membership    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@unique([membershipId, workspaceId])
  @@index([workspaceId, workspaceRole])
  @@index([membershipId])
  @@index([deletedAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String?  @db.Uuid
  userId       String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, action, createdAt])
  @@index([userId, action, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
}

model KnowledgeBase {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  workspaceId String              @db.Uuid
  name        String
  slug        String
  description String?
  status      KnowledgeBaseStatus @default(ACTIVE)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  collections Collection[]
  sources     KnowledgeSource[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, workspaceId, slug])
  @@index([companyId, workspaceId, status])
  @@index([workspaceId, status])
  @@index([deletedAt])
}

model Collection {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  knowledgeBaseId String           @db.Uuid
  name            String
  slug            String
  description     String?
  status          CollectionStatus @default(ACTIVE)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  assets          KnowledgeAsset[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@unique([knowledgeBaseId, slug])
  @@index([companyId, knowledgeBaseId, status])
  @@index([deletedAt])
}

model KnowledgeSource {
  id                String                @id @default(uuid()) @db.Uuid
  companyId         String                @db.Uuid
  knowledgeBaseId   String                @db.Uuid
  name              String
  sourceType        KnowledgeSourceType
  status            KnowledgeSourceStatus @default(ACTIVE)
  connectorConfig   Json?
  syncState         Json?
  externalReference String?
  lastSyncedAt      DateTime?
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  knowledgeBase     KnowledgeBase         @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  assets            KnowledgeAsset[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  @@index([companyId, knowledgeBaseId, status])
  @@index([sourceType, status])
  @@index([externalReference])
  @@index([deletedAt])
}

model KnowledgeAsset {
  id              String               @id @default(uuid()) @db.Uuid
  companyId       String               @db.Uuid
  collectionId    String               @db.Uuid
  sourceId        String?              @db.Uuid
  filename        String
  title           String
  contentType     AssetContentType
  status          KnowledgeAssetStatus @default(PENDING)
  mimeType        String?
  language        String?
  checksum        String?
  storagePath     String?
  sizeBytes       BigInt?
  sourceUpdatedAt DateTime?
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  collection      Collection           @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  source          KnowledgeSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  metadata        DocumentMetadata?
  chunks          Chunk[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@index([companyId, collectionId, status])
  @@index([sourceId, status])
  @@index([checksum])
  @@index([deletedAt])
}

model DocumentMetadata {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @db.Uuid
  knowledgeAssetId String          @unique @db.Uuid
  author           String?
  sourceCreatedAt  DateTime?
  sourceUpdatedAt  DateTime?
  pageCount        Int?
  metadata         Json?
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  knowledgeAsset   KnowledgeAsset  @relation(fields: [knowledgeAssetId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@index([companyId])
  @@index([deletedAt])
}

model Chunk {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @db.Uuid
  knowledgeAssetId String          @db.Uuid
  chunkIndex       Int
  content          String
  tokenCount       Int?
  startOffset      Int?
  endOffset        Int?
  metadata         Json?
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  knowledgeAsset   KnowledgeAsset  @relation(fields: [knowledgeAssetId], references: [id], onDelete: Cascade)
  embeddings       Embedding[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@unique([knowledgeAssetId, chunkIndex])
  @@index([companyId, knowledgeAssetId])
  @@index([knowledgeAssetId, deletedAt])
  @@index([deletedAt])
}

model Embedding {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  chunkId       String   @db.Uuid
  provider      String
  model         String
  dimensions    Int
  vectorVersion Int      @default(1)
  values        Json?
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chunk         Chunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([chunkId, provider, model, vectorVersion])
  @@index([companyId, provider, model])
  @@index([chunkId])
  @@index([deletedAt])
}

